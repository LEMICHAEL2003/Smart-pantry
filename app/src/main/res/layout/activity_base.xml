<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/page_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" android:textColor="#244A35" android:paddingBottom="8dp" android:accessibilityHeading="true" />
    <TextView android:id="@+id/page_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#4F5950" android:paddingBottom="12dp" />
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/nav_pantry" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pantry" android:textAllCaps="false" />
        <Button android:id="@+id/nav_recipes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recipes" android:textAllCaps="false" />
        <Button android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Settings" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
